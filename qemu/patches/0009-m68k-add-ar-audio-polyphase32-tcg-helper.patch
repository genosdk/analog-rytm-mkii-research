+static void ar_audio_polyphase_mac(CPUM68KState *env, unsigned acc,
+                                   uint32_t left, uint32_t right,
+                                   bool subtract)
+{
+    uint64_t product;
+
+    env->macsr &= ~(MACSR_N | MACSR_Z | MACSR_V | MACSR_EV);
+    product = HELPER(macmulf)(env, left, right);
+    if (subtract) {
+        env->macc[acc] -= product;
+    } else {
+        env->macc[acc] += product;
+    }
+    HELPER(macsatf)(env, acc);
+    HELPER(mac_set_flags)(env, acc);
+}
+
+uint32_t HELPER(ar_audio_polyphase32)(CPUM68KState *env)
+{
+    static const bool subtract[4][4] = {
+        { false, true,  true,  true  },
+        { true,  false, true,  true  },
+        { true,  true,  false, true  },
+        { true,  true,  true,  false },
+    };
+    static const uint32_t displacement[4] = { 124, 252, 380, 0 };
+
+    if (!env->ar_audio_polyphase32_control || env->dregs[0] != 32 ||
+        (env->macsr & (MACSR_OMC | MACSR_SU | MACSR_FI | MACSR_RT)) !=
+            (MACSR_OMC | MACSR_FI) || env->mac_mask != UINT32_MAX) {
+        return 0;
+    }
+    if (env->ar_audio_polyphase32_control == 2) {
+        env->ar_audio_polyphase32_control = 0;
+    }
+
+    for (unsigned iteration = 0; iteration < 32; iteration++) {
+        for (unsigned coefficient = 0; coefficient < 4; coefficient++) {
+            uint32_t loaded;
+
+            for (unsigned acc = 0; acc < 4; acc++) {
+                ar_audio_polyphase_mac(env, acc,
+                    env->dregs[3 + coefficient], env->dregs[1],
+                    subtract[coefficient][acc]);
+            }
+            loaded = cpu_ldl_data_ra(env,
+                (env->aregs[0] + displacement[coefficient]) & env->mac_mask,
+                GETPC());
+            env->dregs[1] = loaded;
+            if (coefficient == 3) {
+                env->aregs[0] += 4;
+            }
+        }
+
+        env->dregs[2] = ar_audio_inner_movclr(env, 0);
+        cpu_stl_data_ra(env, env->aregs[1] - 528, env->dregs[2], GETPC());
+        env->dregs[2] = ar_audio_inner_movclr(env, 1);
+        cpu_stl_data_ra(env, env->aregs[1] - 352, env->dregs[2], GETPC());
+        env->dregs[2] = ar_audio_inner_movclr(env, 2);
+        cpu_stl_data_ra(env, env->aregs[1] - 176, env->dregs[2], GETPC());
+        env->dregs[2] = ar_audio_inner_movclr(env, 3);
+        cpu_stl_data_ra(env, env->aregs[1], env->dregs[2], GETPC());
+        env->aregs[1] += 4;
+        env->dregs[0]--;
+    }
+    cpu_m68k_set_ccr(env, CCF_Z);
+    return 1;
+}
