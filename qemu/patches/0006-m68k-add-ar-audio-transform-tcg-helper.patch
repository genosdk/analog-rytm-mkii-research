From: AR MKII research <research@example.invalid>
Subject: [PATCH] target/m68k: add opt-in AR control-transform helper

Add the second disabled-by-default AR audio accelerator: a direct-state helper
for the validated 286-pair control transform.  Keep a separate one-shot control
so the shadow plugin can compare a native call with an accelerated replay.
---
 gdbstub/gdb-xml/cf-emac.xml |  1 +
 target/m68k/cpu.h           |  2 +
 target/m68k/helper.c        | 75 +++++++++++++++++++++++++++++++++++++
 target/m68k/helper.h        |  1 +
 target/m68k/translate.c     | 10 +++++
 5 files changed, 89 insertions(+)

diff --git a/target/m68k/cpu.h b/target/m68k/cpu.h
--- a/target/m68k/cpu.h
+++ b/target/m68k/cpu.h
@@ -156,6 +156,8 @@ typedef struct CPUArchState {
     uint64_t features;
     bool ar_audio_inner_accel;
     uint32_t ar_audio_inner_control;
+    bool ar_audio_transform_accel;
+    uint32_t ar_audio_transform_control;
 } CPUM68KState;
 
 /*
diff --git a/target/m68k/helper.h b/target/m68k/helper.h
--- a/target/m68k/helper.h
+++ b/target/m68k/helper.h
@@ -108,5 +108,6 @@ DEF_HELPER_3(set_mac_exts, void, env, i32, i32)
 DEF_HELPER_3(set_mac_extu, void, env, i32, i32)
 DEF_HELPER_1(ar_audio_inner, i32, env)
+DEF_HELPER_1(ar_audio_transform, i32, env)
 
 DEF_HELPER_2(flush_flags, void, env, i32)
 DEF_HELPER_2(set_ccr, void, env, i32)
diff --git a/target/m68k/helper.c b/target/m68k/helper.c
--- a/target/m68k/helper.c
+++ b/target/m68k/helper.c
@@ -139,6 +139,8 @@ static int cf_emac_gdb_get_reg(CPUState *cs, GByteArray *mem_buf, int n)
         return gdb_get_reg32(mem_buf, env->mac_mask);
     case 6:
         return gdb_get_reg32(mem_buf, env->ar_audio_inner_control);
+    case 7:
+        return gdb_get_reg32(mem_buf, env->ar_audio_transform_control);
     }
     return 0;
 }
@@ -162,6 +164,9 @@ static int cf_emac_gdb_set_reg(CPUState *cs, uint8_t *mem_buf, int n)
     case 6:
         env->ar_audio_inner_control = ldl_be_p(mem_buf);
         return 4;
+    case 7:
+        env->ar_audio_transform_control = ldl_be_p(mem_buf);
+        return 4;
     }
     return 0;
 }
@@ -1571,6 +1576,76 @@ uint32_t HELPER(ar_audio_inner)(CPUM68KState *env)
     return 1;
 }
 
+static uint32_t ar_audio_transform_word(uint32_t value, bool upper)
+{
+    return upper ? value & 0xffff0000U : value << 16;
+}
+
+static void ar_audio_transform_mac(CPUM68KState *env, unsigned acc,
+                                   uint32_t left, uint32_t right)
+{
+    env->macsr &= ~(MACSR_N | MACSR_Z | MACSR_V | MACSR_EV);
+    env->macc[acc] += HELPER(macmulf)(env, left, right);
+    HELPER(macsatf)(env, acc);
+    HELPER(mac_set_flags)(env, acc);
+}
+
+uint32_t HELPER(ar_audio_transform)(CPUM68KState *env)
+{
+    if (!env->ar_audio_transform_control || env->dregs[3] != 572 ||
+        (env->macsr & (MACSR_OMC | MACSR_SU | MACSR_FI | MACSR_RT)) !=
+            MACSR_FI || env->mac_mask != UINT32_MAX) {
+        return 0;
+    }
+    if (env->ar_audio_transform_control == 2) {
+        env->ar_audio_transform_control = 0;
+    }
+
+    for (unsigned iteration = 0; iteration < 286; iteration++) {
+        uint32_t loaded;
+
+        loaded = cpu_ldl_data_ra(env, env->aregs[2], GETPC());
+        ar_audio_transform_mac(env, 0,
+            ar_audio_transform_word(env->dregs[0], true),
+            ar_audio_transform_word(env->dregs[7], true));
+        env->dregs[4] = loaded;
+        ar_audio_transform_mac(env, 0, env->dregs[4], env->dregs[6]);
+
+        cpu_stl_data_ra(env, env->aregs[5], env->dregs[1], GETPC());
+        env->aregs[5] += 4;
+
+        loaded = cpu_ldl_data_ra(env, env->aregs[2] + 4, GETPC());
+        ar_audio_transform_mac(env, 1,
+            ar_audio_transform_word(env->dregs[0], false),
+            ar_audio_transform_word(env->dregs[7], true));
+        env->dregs[0] = loaded;
+
+        loaded = cpu_ldl_data_ra(env, env->aregs[1], GETPC());
+        ar_audio_transform_mac(env, 1, env->dregs[0], env->dregs[6]);
+        env->dregs[0] = loaded;
+        env->aregs[1] += 4;
+
+        env->dregs[1] = ar_audio_inner_movclr(env, 0);
+        cpu_stl_data_ra(env, env->aregs[2], env->dregs[1], GETPC());
+        env->aregs[2] += 4;
+        env->dregs[4] = ar_audio_inner_movclr(env, 1);
+        cpu_stl_data_ra(env, env->aregs[2], env->dregs[4], GETPC());
+        env->aregs[2] += 4;
+
+        env->dregs[4] += env->dregs[2];
+        env->dregs[4] = (env->dregs[4] << 16) | (env->dregs[4] >> 16);
+        env->dregs[1] += env->dregs[2];
+        env->dregs[1] = (env->dregs[1] & 0xffff0000U) |
+                        (env->dregs[4] & 0xffffU);
+        env->dregs[3] -= 2;
+    }
+    cpu_stl_data_ra(env, env->aregs[5], env->dregs[1], GETPC());
+    env->aregs[5] += 4;
+    cpu_m68k_set_ccr(env, env->dregs[1] == 0 ? CCF_Z :
+                          (env->dregs[1] & 0x80000000U ? CCF_N : 0));
+    return 1;
+}
+
 uint32_t HELPER(get_macs)(uint64_t val)
 {
     if (val == (int32_t)val) {
diff --git a/target/m68k/translate.c b/target/m68k/translate.c
--- a/target/m68k/translate.c
+++ b/target/m68k/translate.c
@@ -6060,6 +6060,16 @@ static void m68k_tr_translate_insn(DisasContextBase *dcbase, CPUState *cpu)
         tcg_gen_exit_tb(NULL, 0);
         gen_set_label(native);
     }
+    if (env->ar_audio_transform_accel && dc->base.pc_next == 0x4011c56e) {
+        TCGLabel *native = gen_new_label();
+        TCGv_i32 accelerated = tcg_temp_new_i32();
+
+        gen_helper_ar_audio_transform(accelerated, tcg_env);
+        tcg_gen_brcondi_i32(TCG_COND_EQ, accelerated, 0, native);
+        tcg_gen_movi_i32(QREG_PC, 0x4011c598);
+        tcg_gen_exit_tb(NULL, 0);
+        gen_set_label(native);
+    }
 
     insn = read_im16(env, dc);
 
diff --git a/gdbstub/gdb-xml/cf-emac.xml b/gdbstub/gdb-xml/cf-emac.xml
--- a/gdbstub/gdb-xml/cf-emac.xml
+++ b/gdbstub/gdb-xml/cf-emac.xml
@@ -8,4 +8,5 @@
   <reg name="macsr" bitsize="32" type="uint32" group="system"/>
   <reg name="mac_mask" bitsize="32" type="uint32" group="system"/>
   <reg name="ar_audio_inner_control" bitsize="32" type="uint32" group="system"/>
+  <reg name="ar_audio_transform_control" bitsize="32" type="uint32" group="system"/>
 </feature>
--
