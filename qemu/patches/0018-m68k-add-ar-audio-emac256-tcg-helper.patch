From: AR MKII clean-room research
Subject: [PATCH 18/18] m68k: add guarded eight-pass EMAC helper

---
 gdbstub/gdb-xml/cf-emac.xml |  1 +
 target/m68k/cpu.h           |  2 ++
 target/m68k/helper.c        | 82 +++++++++++++++++++++++++++++++++++++++++++++
 target/m68k/helper.h        |  1 +
 target/m68k/translate.c     | 10 +++++
 5 files changed, 96 insertions(+)

diff --git a/gdbstub/gdb-xml/cf-emac.xml b/gdbstub/gdb-xml/cf-emac.xml
--- a/gdbstub/gdb-xml/cf-emac.xml
+++ b/gdbstub/gdb-xml/cf-emac.xml
@@ -20,4 +20,5 @@
   <reg name="ar_audio_mix32e_control" bitsize="32" type="uint32" group="system"/>
   <reg name="ar_audio_mix32f_control" bitsize="32" type="uint32" group="system"/>
   <reg name="ar_audio_mix32g_control" bitsize="32" type="uint32" group="system"/>
+  <reg name="ar_audio_emac256_control" bitsize="32" type="uint32" group="system"/>
 </feature>
diff --git a/target/m68k/cpu.h b/target/m68k/cpu.h
--- a/target/m68k/cpu.h
+++ b/target/m68k/cpu.h
@@ -180,4 +180,6 @@ typedef struct CPUArchState {
     uint32_t ar_audio_mix32f_control;
     bool ar_audio_mix32g_accel;
     uint32_t ar_audio_mix32g_control;
+    bool ar_audio_emac256_accel;
+    uint32_t ar_audio_emac256_control;
 } CPUM68KState;
diff --git a/target/m68k/helper.c b/target/m68k/helper.c
--- a/target/m68k/helper.c
+++ b/target/m68k/helper.c
@@ -163,4 +163,6 @@ static int cf_emac_gdb_get_reg(CPUState *cs, GByteArray *mem_buf, int n)
         return gdb_get_reg32(mem_buf, env->ar_audio_mix32f_control);
     case 18:
         return gdb_get_reg32(mem_buf, env->ar_audio_mix32g_control);
+    case 19:
+        return gdb_get_reg32(mem_buf, env->ar_audio_emac256_control);
     }
@@ -222,4 +224,7 @@ static int cf_emac_gdb_set_reg(CPUState *cs, uint8_t *mem_buf, int n)
     case 18:
         env->ar_audio_mix32g_control = ldl_be_p(mem_buf);
         return 4;
+    case 19:
+        env->ar_audio_emac256_control = ldl_be_p(mem_buf);
+        return 4;
     }
@@ -2283,6 +2288,83 @@ uint32_t HELPER(ar_audio_mix32g)(CPUM68KState *env)
     }
     cpu_m68k_set_ccr(env, CCF_Z);
     return 1;
+}
+
+uint32_t HELPER(ar_audio_emac256)(CPUM68KState *env)
+{
+    if (!env->ar_audio_emac256_control || env->dregs[3] != 8 ||
+        (env->macsr & (MACSR_OMC | MACSR_SU | MACSR_FI | MACSR_RT)) !=
+            (MACSR_OMC | MACSR_FI) || env->mac_mask != UINT32_MAX) {
+        return 0;
+    }
+    if (env->ar_audio_emac256_control == 2) {
+        env->ar_audio_emac256_control = 0;
+    }
+
+    for (unsigned outer = 0; outer < 8; outer++) {
+        uint32_t loaded;
+
+        env->aregs[0] = 0x8000cc3c;
+        env->dregs[6] = cpu_ldl_data_ra(env,
+            env->aregs[2] & env->mac_mask, GETPC());
+        env->aregs[2] += 4;
+
+        env->macc[0] = (uint64_t)((int64_t)(int32_t)0x80000000U * 256);
+        env->macsr &= ~MACSR_PAV0;
+        ar_audio_inner_clear_mac_flags(env);
+        HELPER(mac_set_flags)(env, 0);
+
+        loaded = cpu_ldl_data_ra(env,
+            env->aregs[0] & env->mac_mask, GETPC());
+        ar_audio_transform_mac(env, 0, env->dregs[6], env->dregs[6]);
+        env->dregs[1] = loaded;
+        env->aregs[0] += 4;
+
+        env->aregs[1] += 28;
+        env->dregs[0] = 32;
+        env->dregs[2] = cpu_ldl_data_ra(env,
+            env->aregs[1] & env->mac_mask, GETPC());
+        env->aregs[1] += 4;
+        env->dregs[7] = ar_audio_inner_movclr(env, 0);
+
+        for (unsigned iteration = 0; iteration < 32; iteration++) {
+            env->dregs[4] = ar_audio_inner_movclr(env, 0);
+            cpu_stl_data_ra(env, env->aregs[1] - 8,
+                            env->dregs[4], GETPC());
+
+            env->macc[0] =
+                (uint64_t)((int64_t)(int32_t)env->dregs[1] * 256);
+            env->macsr &= ~MACSR_PAV0;
+            ar_audio_inner_clear_mac_flags(env);
+            HELPER(mac_set_flags)(env, 0);
+            ar_audio_transform_mac(env, 0, env->dregs[2], env->dregs[6]);
+
+            env->dregs[4] = ar_audio_inner_movclr(env, 1);
+            cpu_stl_data_ra(env, env->aregs[0] - 8,
+                            env->dregs[4], GETPC());
+
+            loaded = cpu_ldl_data_ra(env,
+                env->aregs[0] & env->mac_mask, GETPC());
+            ar_audio_transform_mac(env, 1, env->dregs[1], env->dregs[6]);
+            env->dregs[1] = loaded;
+            env->aregs[0] += 4;
+
+            loaded = cpu_ldl_data_ra(env,
+                env->aregs[1] & env->mac_mask, GETPC());
+            ar_audio_transform_mac(env, 1, env->dregs[2], env->dregs[7]);
+            env->dregs[2] = loaded;
+            env->aregs[1] += 4;
+            env->dregs[0]--;
+        }
+
+        env->dregs[4] = ar_audio_inner_movclr(env, 0);
+        cpu_stl_data_ra(env, env->aregs[1] - 8, env->dregs[4], GETPC());
+        env->dregs[4] = ar_audio_inner_movclr(env, 1);
+        cpu_stl_data_ra(env, env->aregs[0] - 8, env->dregs[4], GETPC());
+        env->dregs[3]--;
+    }
+    cpu_m68k_set_ccr(env, CCF_Z);
+    return 1;
 }
 
 uint32_t HELPER(get_macs)(uint64_t val)
 {
diff --git a/target/m68k/helper.h b/target/m68k/helper.h
--- a/target/m68k/helper.h
+++ b/target/m68k/helper.h
@@ -121,2 +121,3 @@
 DEF_HELPER_1(ar_audio_mix32f, i32, env)
 DEF_HELPER_1(ar_audio_mix32g, i32, env)
+DEF_HELPER_1(ar_audio_emac256, i32, env)
diff --git a/target/m68k/translate.c b/target/m68k/translate.c
--- a/target/m68k/translate.c
+++ b/target/m68k/translate.c
@@ -6181,5 +6181,15 @@ static void m68k_tr_translate_insn(DisasContextBase *dcbase, CPUState *cpu)
         tcg_gen_exit_tb(NULL, 0);
         gen_set_label(native);
     }
+    if (env->ar_audio_emac256_accel && dc->base.pc_next == 0x40108e10) {
+        TCGLabel *native = gen_new_label();
+        TCGv_i32 accelerated = tcg_temp_new_i32();
+
+        gen_helper_ar_audio_emac256(accelerated, tcg_env);
+        tcg_gen_brcondi_i32(TCG_COND_EQ, accelerated, 0, native);
+        tcg_gen_movi_i32(QREG_PC, 0x40108e5a);
+        tcg_gen_exit_tb(NULL, 0);
+        gen_set_label(native);
+    }
 
     insn = read_im16(env, dc);
-- 
