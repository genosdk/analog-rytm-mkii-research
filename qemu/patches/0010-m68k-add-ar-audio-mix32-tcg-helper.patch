+uint32_t HELPER(ar_audio_mix32)(CPUM68KState *env)
+{
+    if (!env->ar_audio_mix32_control || env->dregs[0] != 32 ||
+        (env->macsr & (MACSR_OMC | MACSR_SU | MACSR_FI | MACSR_RT)) !=
+            (MACSR_OMC | MACSR_FI) || env->mac_mask != UINT32_MAX) {
+        return 0;
+    }
+    if (env->ar_audio_mix32_control == 2) {
+        env->ar_audio_mix32_control = 0;
+    }
+
+    for (unsigned iteration = 0; iteration < 32; iteration++) {
+        uint32_t loaded;
+
+        ar_audio_polyphase_mac(env, 0, env->dregs[1], env->dregs[4], false);
+        loaded = cpu_ldl_data_ra(env, env->aregs[0] & env->mac_mask, GETPC());
+        env->dregs[1] = loaded;
+        env->aregs[0] += 4;
+        ar_audio_polyphase_mac(env, 0, env->dregs[1], env->dregs[3], false);
+        ar_audio_polyphase_mac(env, 0, env->dregs[6], env->dregs[5], true);
+
+        ar_audio_polyphase_mac(env, 1, env->dregs[2], env->dregs[4], false);
+        env->dregs[2] = cpu_ldl_data_ra(env,
+            (env->aregs[1] + 128) & env->mac_mask, GETPC());
+        ar_audio_polyphase_mac(env, 1, env->dregs[2], env->dregs[3], false);
+        ar_audio_polyphase_mac(env, 1, env->aregs[2], env->dregs[5], true);
+        env->dregs[6] = cpu_ldl_data_ra(env,
+            env->aregs[3] & env->mac_mask, GETPC());
+
+        ar_audio_polyphase_mac(env, 2, env->dregs[6], env->dregs[7], false);
+        env->dregs[6] = cpu_ldl_data_ra(env,
+            (env->aregs[3] + 4) & env->mac_mask, GETPC());
+        ar_audio_polyphase_mac(env, 3, env->dregs[6], env->dregs[7], false);
+        env->dregs[6] = cpu_ldl_data_ra(env,
+            (env->aregs[4] + 128) & env->mac_mask, GETPC());
+        ar_audio_polyphase_mac(env, 2, env->dregs[6], env->dregs[7], false);
+        env->dregs[6] = cpu_ldl_data_ra(env,
+            (env->aregs[4] + 384) & env->mac_mask, GETPC());
+        ar_audio_polyphase_mac(env, 2, env->dregs[6], env->dregs[7], false);
+        env->dregs[6] = cpu_ldl_data_ra(env,
+            env->aregs[4] & env->mac_mask, GETPC());
+        env->aregs[4] += 4;
+        ar_audio_polyphase_mac(env, 3, env->dregs[6], env->dregs[7], false);
+        env->dregs[6] = cpu_ldl_data_ra(env,
+            (env->aregs[4] + 252) & env->mac_mask, GETPC());
+        ar_audio_polyphase_mac(env, 3, env->dregs[6], env->dregs[7], false);
+
+        env->dregs[6] = ar_audio_inner_movclr(env, 0);
+        cpu_stl_data_ra(env, env->aregs[1], env->dregs[6], GETPC());
+        env->aregs[1] += 4;
+        env->aregs[2] = ar_audio_inner_movclr(env, 2);
+        cpu_stl_data_ra(env, env->aregs[3], env->aregs[2], GETPC());
+        env->aregs[3] += 4;
+        env->aregs[2] = ar_audio_inner_movclr(env, 3);
+        cpu_stl_data_ra(env, env->aregs[3], env->aregs[2], GETPC());
+        env->aregs[3] += 4;
+        env->aregs[2] = ar_audio_inner_movclr(env, 1);
+        cpu_stl_data_ra(env, env->aregs[1] + 124, env->aregs[2], GETPC());
+        env->dregs[0]--;
+    }
+    cpu_m68k_set_ccr(env, CCF_Z);
+    return 1;
+}
