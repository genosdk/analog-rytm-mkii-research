From: AR MKII clean-room research
Subject: [PATCH 17/17] m68k: add guarded second pipelined mix helper

---
 gdbstub/gdb-xml/cf-emac.xml |  1 +
 target/m68k/cpu.h           |  2 ++
 target/m68k/helper.c        | 60 +++++++++++++++++++++++++++++++++++++++++++++
 target/m68k/helper.h        |  1 +
 target/m68k/translate.c     | 10 ++++++++
 5 files changed, 74 insertions(+)

diff --git a/gdbstub/gdb-xml/cf-emac.xml b/gdbstub/gdb-xml/cf-emac.xml
--- a/gdbstub/gdb-xml/cf-emac.xml
+++ b/gdbstub/gdb-xml/cf-emac.xml
@@ -19,4 +19,5 @@
   <reg name="ar_audio_mix32d_control" bitsize="32" type="uint32" group="system"/>
   <reg name="ar_audio_mix32e_control" bitsize="32" type="uint32" group="system"/>
   <reg name="ar_audio_mix32f_control" bitsize="32" type="uint32" group="system"/>
+  <reg name="ar_audio_mix32g_control" bitsize="32" type="uint32" group="system"/>
 </feature>
diff --git a/target/m68k/cpu.h b/target/m68k/cpu.h
--- a/target/m68k/cpu.h
+++ b/target/m68k/cpu.h
@@ -178,4 +178,6 @@ typedef struct CPUArchState {
     uint32_t ar_audio_mix32e_control;
     bool ar_audio_mix32f_accel;
     uint32_t ar_audio_mix32f_control;
+    bool ar_audio_mix32g_accel;
+    uint32_t ar_audio_mix32g_control;
 } CPUM68KState;
diff --git a/target/m68k/helper.c b/target/m68k/helper.c
--- a/target/m68k/helper.c
+++ b/target/m68k/helper.c
@@ -161,4 +161,6 @@ static int cf_emac_gdb_get_reg(CPUState *cs, GByteArray *mem_buf, int n)
         return gdb_get_reg32(mem_buf, env->ar_audio_mix32e_control);
     case 17:
         return gdb_get_reg32(mem_buf, env->ar_audio_mix32f_control);
+    case 18:
+        return gdb_get_reg32(mem_buf, env->ar_audio_mix32g_control);
     }
@@ -212,4 +214,7 @@ static int cf_emac_gdb_set_reg(CPUState *cs, uint8_t *mem_buf, int n)
     case 17:
         env->ar_audio_mix32f_control = ldl_be_p(mem_buf);
         return 4;
+    case 18:
+        env->ar_audio_mix32g_control = ldl_be_p(mem_buf);
+        return 4;
     }
@@ -2237,5 +2242,60 @@ uint32_t HELPER(ar_audio_mix32f)(CPUM68KState *env)
         env->dregs[0]--;
     }
     cpu_m68k_set_ccr(env, CCF_Z);
+    return 1;
+}
+
+uint32_t HELPER(ar_audio_mix32g)(CPUM68KState *env)
+{
+    if (!env->ar_audio_mix32g_control || env->dregs[0] != 32 ||
+        (env->macsr & (MACSR_OMC | MACSR_SU | MACSR_FI | MACSR_RT)) !=
+            (MACSR_OMC | MACSR_FI) || env->mac_mask != UINT32_MAX) {
+        return 0;
+    }
+    if (env->ar_audio_mix32g_control == 2) {
+        env->ar_audio_mix32g_control = 0;
+    }
+
+    for (unsigned iteration = 0; iteration < 32; iteration++) {
+        uint32_t loaded;
+
+        loaded = cpu_ldl_data_ra(env,
+            (env->aregs[0] + 4) & env->mac_mask, GETPC());
+        ar_audio_polyphase_mac(env, 0, env->dregs[7], env->aregs[3], true);
+        env->dregs[7] = loaded;
+        ar_audio_polyphase_mac(env, 2, env->dregs[7], env->aregs[6], true);
+
+        loaded = cpu_ldl_data_ra(env,
+            (env->aregs[0] - 4) & env->mac_mask, GETPC());
+        ar_audio_polyphase_mac(env, 0, env->dregs[7], env->aregs[5], true);
+        env->dregs[7] = loaded;
+
+        loaded = cpu_ldl_data_ra(env,
+            (env->aregs[0] - 8) & env->mac_mask, GETPC());
+        ar_audio_polyphase_mac(env, 0, env->dregs[7], env->dregs[5], true);
+        env->dregs[1] = loaded;
+        ar_audio_polyphase_mac(env, 0, env->dregs[1], env->dregs[2], true);
+
+        env->dregs[1] = ar_audio_inner_movclr(env, 2);
+        ar_audio_polyphase_mac(env, 0, env->dregs[4], env->dregs[1], false);
+
+        loaded = cpu_ldl_data_ra(env,
+            env->aregs[0] & env->mac_mask, GETPC());
+        ar_audio_polyphase_mac(env, 2, env->dregs[7], env->dregs[3], true);
+        env->dregs[1] = loaded;
+        env->aregs[0] += 4;
+
+        loaded = cpu_ldl_data_ra(env,
+            env->aregs[0] & env->mac_mask, GETPC());
+        ar_audio_polyphase_mac(env, 2, env->dregs[1], env->dregs[6], true);
+        env->dregs[7] = loaded;
+        ar_audio_polyphase_mac(env, 2, env->dregs[7], env->aregs[4], true);
+
+        env->dregs[1] = ar_audio_inner_movclr(env, 0);
+        cpu_stl_data_ra(env, env->aregs[1], env->dregs[1], GETPC());
+        env->aregs[1] += 4;
+        env->dregs[0]--;
+    }
+    cpu_m68k_set_ccr(env, CCF_Z);
     return 1;
 }
diff --git a/target/m68k/helper.h b/target/m68k/helper.h
--- a/target/m68k/helper.h
+++ b/target/m68k/helper.h
@@ -120,2 +120,3 @@
 DEF_HELPER_1(ar_audio_mix32e, i32, env)
 DEF_HELPER_1(ar_audio_mix32f, i32, env)
+DEF_HELPER_1(ar_audio_mix32g, i32, env)
diff --git a/target/m68k/translate.c b/target/m68k/translate.c
--- a/target/m68k/translate.c
+++ b/target/m68k/translate.c
@@ -6171,5 +6171,15 @@ static void m68k_tr_translate_insn(DisasContextBase *dcbase, CPUState *cpu)
         tcg_gen_exit_tb(NULL, 0);
         gen_set_label(native);
     }
+    if (env->ar_audio_mix32g_accel && dc->base.pc_next == 0x40108ef8) {
+        TCGLabel *native = gen_new_label();
+        TCGv_i32 accelerated = tcg_temp_new_i32();
+
+        gen_helper_ar_audio_mix32g(accelerated, tcg_env);
+        tcg_gen_brcondi_i32(TCG_COND_EQ, accelerated, 0, native);
+        tcg_gen_movi_i32(QREG_PC, 0x40108f2c);
+        tcg_gen_exit_tb(NULL, 0);
+        gen_set_label(native);
+    }
 
     insn = read_im16(env, dc);
-- 
2.43.0
